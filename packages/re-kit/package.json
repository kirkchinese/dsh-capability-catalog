{
  "name": "@kirkchinese/dsh-re-kit",
  "version": "0.1.3",
  "description": "One-step kit for DeepSeek Harness: the lazy capability catalog (MCP tools and skills behind one compact index) plus REA reverse engineering",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rea",
    "mcp",
    "skills",
    "kit"
  ],
  "license": "MIT",
  "author": "kirkchinese",
  "type": "module",
  "exports": {
    "./catalog.patch.yml": "./catalog.patch.yml",
    "./rea.patch.yml": "./rea.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "catalog.patch.yml",
    "rea.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./catalog.patch.yml",
        "./rea.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@kirkchinese/dsh-capability-catalog": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirkchinese/dsh-capability-catalog.git",
    "directory": "packages/re-kit"
  },
  "homepage": "https://github.com/kirkchinese/dsh-capability-catalog#readme"
}
